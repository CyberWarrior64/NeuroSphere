# From the project root, copy this to infra/.env and replace mandatory placeholders.
# Before Compose startup, package the Java API with the Maven image:
# docker run --rm -v "$PWD/platform-api:/workspace" -w /workspace maven:3.9.9-eclipse-temurin-21 mvn -B -DskipTests package
# Generate the JWT secret with: openssl rand -base64 48
MYSQL_DATABASE=neurosphere_platform
MYSQL_USER=neurosphere_app
MYSQL_PASSWORD=CHANGE_ME_LONG_RANDOM_APP_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_LONG_RANDOM_ROOT_PASSWORD
NS_JWT_SECRET_BASE64=REPLACE_WITH_OUTPUT_OF_OPENSSL_RAND_BASE64_48

# Optional first-start admin bootstrap: set BOTH values only for first startup,
# then remove them after the first admin account has been created.
# NS_BOOTSTRAP_USERNAME=
# NS_BOOTSTRAP_PASSWORD=

# These defaults point to the current Ubuntu loopback services.
NS_AI_ENGINE_URL=http://127.0.0.1:8000
NS_CORS_ALLOWED_ORIGINS=http://127.0.0.1:8765
